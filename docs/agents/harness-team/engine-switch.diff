diff --git a/scripts/agents/run-opencode.test.mjs b/scripts/agents/run-opencode.test.mjs
new file mode 100644
index 0000000..c621742
--- /dev/null
+++ b/scripts/agents/run-opencode.test.mjs
@@ -0,0 +1,66 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { opencodeConfig, resolveModel, costMode, stopReason, newTotals, tally, childEnv, tokensUsed } from "./run-opencode.mjs";
+
+test("endpoint/default resolves from AGENTS_LLM_MODEL and fails closed without it", () => {
+  assert.equal(resolveModel("endpoint/default", { AGENTS_LLM_MODEL: "qwen3-coder" }), "endpoint/qwen3-coder");
+  assert.equal(resolveModel("endpoint/llama-x", {}), "endpoint/llama-x");
+  assert.throws(() => resolveModel("endpoint/default", {}), /AGENTS_LLM_MODEL/);
+});
+
+test("free and paid routes are told apart", () => {
+  assert.equal(costMode("endpoint/qwen3-coder"), "free");
+  assert.equal(costMode("openrouter/x/y:free"), "free");
+  assert.equal(costMode("openrouter/deepseek/deepseek-v4.1-flash"), "paid");
+});
+
+test("the endpoint provider is OpenAI-compatible, keyed by env, with the context limit", () => {
+  const c = opencodeConfig({ model: "endpoint/m1", env: { AGENTS_LLM_CONTEXT: "16000", AGENTS_LLM_OUTPUT: "2048" } });
+  const p = c.provider.endpoint;
+  assert.equal(p.npm, "@ai-sdk/openai-compatible");
+  assert.equal(p.options.baseURL, "{env:AGENTS_LLM_BASE_URL}");
+  assert.equal(p.options.apiKey, "{env:AGENTS_LLM_API_KEY}");
+  assert.deepEqual(p.models.m1.limit, { context: 16000, output: 2048 });
+  assert.ok(!JSON.stringify(c).match(/sk-|ghp_|ghs_/), "no literal keys in the config");
+});
+
+test("--auto cannot approve the ask-by-default kinds, the web, or a merge through the API", () => {
+  const c = opencodeConfig({ model: "endpoint/m1", env: {} });
+  for (const k of ["external_directory", "doom_loop", "webfetch", "websearch"]) assert.equal(c.permission[k], "deny", k);
+  for (const p of ["gh api*/merge*", "gh api*-X PUT*", "curl*"]) assert.equal(c.permission.bash[p], "deny", p);
+  assert.equal(Object.keys(c.permission.bash)[0], "*", "last match wins in OpenCode, so the catch-all goes first");
+});
+
+test("a free route stops on tokens, on any cost, and never on the zero-cost heuristic", () => {
+  const t = newTotals();
+  for (let i = 0; i < 6; i++) tally(t, { type: "step_finish", part: { cost: 0, tokens: { input: 1000, output: 100 } } });
+  const free = { budget: 0, maxTurns: 25, maxTokens: 10_000, mode: "free" };
+  assert.equal(stopReason(t, free), "", "6 zero-cost steps are fine on a free route");
+  tally(t, { type: "step_finish", part: { cost: 0, tokens: { input: 5000, output: 0 } } });
+  assert.equal(tokensUsed(t), 11_600);
+  assert.equal(stopReason(t, free), "error_max_tokens");
+  const billed = newTotals();
+  tally(billed, { type: "step_finish", part: { cost: 0.0001, tokens: { input: 10 } } });
+  assert.equal(stopReason(billed, free), "error_unexpected_cost");
+});
+
+test("a paid route keeps the old dollar cap and the blind-cost stop", () => {
+  const t = newTotals();
+  for (let i = 0; i < 5; i++) tally(t, { type: "step_finish", part: { cost: 0, tokens: { input: 10 } } });
+  assert.equal(stopReason(t, { budget: 2, maxTurns: 80, maxTokens: 0, mode: "paid" }), "error_cost_not_reported");
+});
+
+test("retry events are counted if the stream carries them", () => {
+  const t = newTotals();
+  tally(t, { type: "session.retry.scheduled" });
+  assert.equal(t.retries, 1);
+});
+
+test("--no-github strips every GitHub credential from the agent", () => {
+  const env = childEnv({ GH_TOKEN: "a", GITHUB_TOKEN: "b", ACTIONS_ID_TOKEN_REQUEST_TOKEN: "c", AGENTS_LLM_API_KEY: "k", PATH: "/bin" }, { cfgPath: "/x", noGithub: true });
+  assert.equal(env.GH_TOKEN, undefined);
+  assert.equal(env.GITHUB_TOKEN, undefined);
+  assert.equal(env.ACTIONS_ID_TOKEN_REQUEST_TOKEN, undefined);
+  assert.equal(env.AGENTS_LLM_API_KEY, "k");
+  assert.equal(env.OPENCODE_CONFIG, "/x");
+});
