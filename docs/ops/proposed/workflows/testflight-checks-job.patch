+  build:
+    name: testflight build
+    needs: checks
+    # App builds come from `develop` (TestFlight) or an ios-v tag (docs/DEVELOPMENT.md).
+    if: github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/tags/ios-v')
+    runs-on: ubuntu-latest
+    timeout-minutes: 75
+    # RA-20-06a (AUTOMATION.md 2.0 and 2.3, SECRETS_REVIEW.md 4.3): EXPO_TOKEN is this environment's secret. Its
+    # deployment refs (branch develop only) are the control; the if above is not. Open: a run on an ios-v tag
+    # (ADR 0022 decision 5, C1 builds after the freeze) is refused by those refs until the founder decides
+    # whether the tag joins them or that build moves to app-store.
+    environment: testflight
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      # CR-233: this job holds EXPO_TOKEN, so it restores no cache (package-manager-cache: false keeps it off even if
+      # package.json gains a packageManager field) and installs with install scripts off. What still runs beside
+      # the token: eas-cli (npx installs it with its own scripts) and the app.config.ts and config plugins it loads.
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+          package-manager-cache: false
+      - name: Install from the lockfile, no cache, no install scripts
+        run: npm ci --ignore-scripts --no-audit --no-fund
