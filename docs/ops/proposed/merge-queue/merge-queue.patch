diff --git a/scripts/agents/merge-queue.test.mjs b/scripts/agents/merge-queue.test.mjs
index 800c472e..f67ad8a0 100644
--- a/scripts/agents/merge-queue.test.mjs
+++ b/scripts/agents/merge-queue.test.mjs
@@ -517,2 +517,28 @@ test("CR-73 security lens: an HTML comment block or a line indented four spaces
   assert.deepEqual(namedLenses("   Lens: security-architect\n"), ["security-architect"]);
 });
+
+// HG-MQ
+test("[HG-MQ] apps/mobile/package.json is a native path, as in ios-compile.yml, and eas.json stays one (CR-69 A9)", () => {
+  assert.equal(touchesNative(["apps/mobile/package.json"]), true);
+  assert.equal(touchesNative(["apps/mobile/eas.json"]), true);
+  assert.equal(touchesNative(["apps/mobile/version.json"]), false);
+});
+
+test("[HG-MQ] an eas.json-only PR with a skipped compile check is WATCH-RED, and so is a skipped compile with a failed changes job; a docs PR is not held by it", async () => {
+  const skipped = [run(10, "iOS simulator build (no signing)", "skipped"), run(11, "store-profile Release launch (testflight env, no seam, 20 s)", "success")];
+  const comments = [review("A", HEAD), review("B", HEAD)];
+  const eas = await verdict({ comments, runs: [...good, ...skipped], files: ["apps/mobile/eas.json"] });
+  assert.match(eas.verdict, /^WATCH-RED iOS simulator build/);
+  const changesFailed = await verdict({ comments, runs: [...good, ...skipped, run(12, "native files changed?", "failure")], files: ["apps/mobile/package.json"] });
+  assert.match(changesFailed.verdict, /^WATCH-RED iOS simulator build/);
+  const docs = await verdict({ comments, runs: [...good, ...skipped], files: ["docs/x.md"] });
+  assert.equal(docs.verdict, "READY");
+});
+
+test("[HG-MQ] STALE-REVIEW names the older sha and the delta command", async () => {
+  const r = await verdict({ comments: [review("A", OLD), review("B", HEAD)] });
+  assert.equal(r.verdict, "STALE-REVIEW");
+  assert.equal(r.reviews.staleShas.A, OLD);
+  const text = formatTable([r]);
+  assert.ok(text.includes(`Review A reviewed ${OLD.slice(0, 12)}; delta: git diff ${OLD.slice(0, 12)} ${HEAD.slice(0, 12)} --stat`), text);
+});
