{
  "name": "scribe",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "experiments"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start -w @scribe/mobile",
    "test:db": "node supabase/tests/run.mjs",
    "test:db:perf": "node supabase/tests/run.mjs perf",
    "test:functions": "npx -y deno@2.9.6 test --no-prompt --allow-read supabase/functions/purge-worker supabase/functions/analytics-forget supabase/functions/_shared/log scripts/ops",
    "experiment": "npm run experiment -w @scribe/experiments --",
    "experiment:edits": "npm run experiment:edits -w @scribe/experiments --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
