{
  "name": "scribe",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "experiments"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start -w @scribe/mobile",
    "test:db": "node supabase/tests/run.mjs",
    "test:db:perf": "node supabase/tests/run.mjs perf",
    "experiment": "npm run experiment -w @scribe/experiments --",
    "experiment:edits": "npm run experiment:edits -w @scribe/experiments --",
    "check:data-map": "node scripts/check-data-map.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
