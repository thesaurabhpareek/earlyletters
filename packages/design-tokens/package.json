{
  "name": "@scribe/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for Early Letters (colors, spacing, radii, type, elevation, motion). Zero dependencies; consumable by React Native and web.",
  "main": "src/tokens.ts",
  "types": "src/tokens.ts",
  "sideEffects": false,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsx src/build-css.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": "./src/tokens.ts",
    "./tokens.native.css": "./dist/tokens.native.css",
    "./tokens.web.css": "./dist/tokens.web.css"
  }
}
