# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# output folder of the Expo template's reset-project script (script removed)
/apps/mobile/example/

# generated native folders (prebuild output, at any depth: apps/mobile/ios).
# Hand-written native module sources live under modules/<name>/ios and stay
# tracked via the re-include below.
**/ios/
**/android/
!apps/mobile/modules/*/ios/
!apps/mobile/modules/*/android/

# env and secrets
.env
.env.*
!.env.development
.env*.local
apps/*/.env
credentials.json
GoogleService-Info.plist
google-services.json
supabase/.temp/

# store build artifacts
*.ipa
*.aab
*.apk

# experiments: never commit recordings or model files
experiments/recordings/
experiments/models/
experiments/results/
*.wav
*.m4a
*.bin

# generated token CSS is committed (consumed by Uniwind and web)
!packages/design-tokens/dist/

# rendered email previews
packages/emails/out/
