---
import Base from '../layouts/Base.astro';
import SampleLetter from '../components/SampleLetter.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import Moon from '../components/Moon.astro';
import { site } from '@scribe/content';
import { fill, fillCap } from '../lib/fill';

// Signatures shown beside the family section. Names taken from the copy
// itself ("From Papa, From Nani", "Dadi"); decorative, hidden from screen readers.
const signatures = ['From Nani', 'From Papa', 'From Dadi'];
---
<Base description={site.hero.subhead}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <h1 id="hero-title">{site.hero.headline}</h1>
      <p class="lede">{site.hero.subhead}</p>
      <WaitlistForm id="hero" />
    </div>
    <div class="hero-letter">
      <SampleLetter />
    </div>
  </section>

  <section class="benefits wrap" aria-label="What it is">
    {site.benefits.map((b) => (
      <article class="benefit">
        <h2>{b.title}</h2>
        <p>{fill(b.body)}</p>
      </article>
    ))}
  </section>

  <section class="how wrap" aria-labelledby="how-title">
    <h2 id="how-title">{site.howItWorks.title}</h2>
    <ol>
      {site.howItWorks.steps.map((s, i) => (
        <li>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{fillCap(s.body)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="night" aria-labelledby="rt-title">
    <div class="wrap night-inner">
      <Moon />
      <div>
        <h2 id="rt-title">{site.readTogether.title}</h2>
        <p>{fill(site.readTogether.body)}</p>
      </div>
    </div>
  </section>

  <section class="family wrap" aria-labelledby="family-title">
    <div>
      <h2 id="family-title">{fillCap(site.family.title)}</h2>
      <p>{fill(site.family.body)}</p>
    </div>
    <ul class="sigs" aria-hidden="true">
      {signatures.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  <section class="promise wrap" aria-labelledby="promise-title">
    <h2 id="promise-title">{site.privacy.title}</h2>
    <ul>
      {site.privacy.points.map((p) => <li>{fill(p)}</li>)}
    </ul>
  </section>

  <section class="faq wrap" aria-labelledby="faq-title">
    {/* TODO(C3): site.en.ts has no FAQ heading; "Questions" is interim. */}
    <h2 id="faq-title">Questions</h2>
    <div class="qs">
      {site.faq.map((f) => (
        <details>
          <summary>{fill(f.q)}</summary>
          <p>{fill(f.a)}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="gift wrap" aria-labelledby="gift-title">
    <div class="gift-card">
      <h2 id="gift-title">{site.gift.title}</h2>
      <p>{fill(site.gift.body)}</p>
      {/* TODO(founder): gifting is not built yet; the button leads to the waitlist for now. */}
      <a class="button quiet" href="#waitlist">{site.gift.cta}</a>
    </div>
  </section>

  <section id="waitlist" class="closing wrap" aria-labelledby="waitlist-title">
    <h2 id="waitlist-title">{site.primaryCta}</h2>
    <WaitlistForm id="closing" />
  </section>
</Base>

<script is:inline>
  // The waitlist is not wired yet: stop the browser from sending the address
  // anywhere. Remove once WAITLIST_ENDPOINT is set.
  document.querySelectorAll('form[data-waitlist="todo"]').forEach(function (f) {
    f.addEventListener('submit', function (e) { e.preventDefault(); });
  });
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    gap: var(--s10);
    padding-block: var(--s9) var(--section);
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.012em;
    font-variation-settings: 'opsz' 72;
    max-width: 12ch;
  }
  .lede {
    margin: var(--s6) 0 var(--s8);
    max-width: 30rem;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
      gap: var(--s12);
      padding-top: var(--s12);
    }
    .hero-letter { justify-self: end; }
  }

  /* ---------- benefits: a quiet two-by-two, rules not boxes ---------- */
  .benefits {
    display: grid;
    gap: var(--s9) var(--s12);
  }
  .benefit { border-top: 1px solid var(--line); padding-top: var(--s5); }
  .benefit h2 { font-size: 1.5rem; line-height: 1.25; }
  .benefit p { margin-top: var(--s3); color: var(--ink-muted); max-width: 32rem; }
  @media (min-width: 48rem) {
    .benefits { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- section headings ---------- */
  .how h2, .promise h2, .faq h2, .family h2, .closing h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    line-height: 1.15;
  }

  /* ---------- how it works: a real sequence, so numbered ---------- */
  .how { margin-top: var(--section); }
  .how ol {
    display: grid;
    gap: var(--s8);
    margin: var(--s8) 0 0;
    padding: 0;
    list-style: none;
  }
  .how li { display: grid; grid-template-columns: 3rem 1fr; column-gap: var(--s4); }
  .n {
    grid-row: span 2;
    font: 400 2.5rem/1 var(--serif);
    color: var(--accent);
  }
  .how h3 { font: 600 1.125rem/1.3 var(--sans); }
  .how li p { margin-top: var(--s1); color: var(--ink-muted); }
  @media (min-width: 48rem) {
    .how ol { grid-template-columns: repeat(3, 1fr); gap: var(--s8); }
    .how li { grid-template-columns: 1fr; }
    .n { grid-row: auto; margin-bottom: var(--s3); }
  }

  /* ---------- read together: the page goes dark, like bedtime ---------- */
  .night {
    --ink: var(--night-ink);
    --ink-muted: var(--night-ink-muted);
    --accent: var(--night-accent);
    --focus: var(--night-focus);
    margin-top: var(--section);
    background: var(--night-paper);
    color: var(--ink);
  }
  @media (prefers-color-scheme: dark) {
    .night { background: var(--paper-raised); border-block: 1px solid var(--line); }
  }
  .night-inner {
    display: grid;
    gap: var(--s8);
    padding-block: var(--section);
  }
  .night h2 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem); line-height: 1.1; }
  .night p {
    margin-top: var(--s5);
    max-width: var(--measure);
    font: 400 1.3125rem/1.65 var(--serif);
  }
  @media (min-width: 48rem) {
    .night-inner { grid-template-columns: 10rem 1fr; align-items: start; }
    .night :global(.moon) { margin-top: var(--s2); }
  }

  /* ---------- family ---------- */
  .family {
    display: grid;
    gap: var(--s8);
    margin-top: var(--section);
  }
  .family p { margin-top: var(--s4); max-width: 34rem; color: var(--ink-muted); }
  .sigs {
    margin: 0;
    padding: 0;
    list-style: none;
    font: italic 400 1.5rem/1.2 var(--serif);
    color: var(--ink);
  }
  .sigs li { padding: var(--s3) 0; border-bottom: 1px solid var(--line); }
  .sigs li:nth-child(2) { padding-left: var(--s8); }
  .sigs li:nth-child(3) { padding-left: var(--s4); }
  @media (min-width: 48rem) {
    .family { grid-template-columns: 1.4fr 1fr; align-items: center; gap: var(--s12); }
  }

  /* ---------- promise ---------- */
  .promise { margin-top: var(--section); }
  .promise ul {
    display: grid;
    gap: 0 var(--s12);
    margin: var(--s8) 0 0;
    padding: 0;
    list-style: none;
  }
  .promise li {
    position: relative;
    padding: var(--s4) 0 var(--s4) var(--s6);
    border-top: 1px solid var(--line);
  }
  .promise li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: calc(var(--s4) + 0.62em);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (min-width: 48rem) {
    .promise ul { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- faq ---------- */
  .faq { margin-top: var(--section); }
  .qs { margin-top: var(--s6); max-width: 46rem; border-bottom: 1px solid var(--line); }
  details { border-top: 1px solid var(--line); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s4);
    min-height: 56px;
    padding-block: var(--s3);
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    font-size: 1.1875rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: 4px;
    border-right: 1.5px solid var(--ink-muted);
    border-bottom: 1.5px solid var(--ink-muted);
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.28s;
  }
  details[open] summary::after { transform: translateY(2px) rotate(225deg); }
  details p { padding-bottom: var(--s6); color: var(--ink-muted); max-width: 40rem; }

  /* ---------- gift ---------- */
  .gift { margin-top: var(--section); }
  .gift-card {
    padding: var(--s9) var(--s6);
    background: var(--accent-soft);
    border-radius: var(--r-lg);
  }
  .gift h2 { font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem); line-height: 1.15; }
  .gift p { margin: var(--s4) 0 var(--s6); max-width: 38rem; font: 400 1.1875rem/1.6 var(--serif); }
  @media (min-width: 48rem) { .gift-card { padding: var(--s12); } }

  /* ---------- closing ---------- */
  .closing { margin-top: var(--section); }
  .closing h2 { margin-bottom: var(--s6); }
</style>
