---
import { brand } from '@scribe/brand';
import { lockupSvg } from '../lib/logo';
// Logo lockup from packages/brand/assets/logo (direction set in lib/logo.ts),
// inlined so it takes the theme's ink colour. Falls back to a typographic
// wordmark in Literata if no direction is set.
interface Props { href?: string; size?: 'header' | 'footer' }
const { href = '/', size = 'header' } = Astro.props;
const svg = lockupSvg();
---
<a class={`wordmark ${size}`} href={href} aria-label={`${brand.name}, home`}>
  {svg ? (
    <Fragment set:html={svg} />
  ) : (
    <span class="type">{brand.name}</span>
  )}
</a>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .wordmark :global(.lockup) { height: 26px; width: auto; }
  .footer :global(.lockup) { height: 22px; }
  .type { font: 500 1.3125rem/1 var(--serif); }
</style>
