---
import { brand } from '@scribe/brand';
import { lockupSvg } from '../lib/logo';
// Primary lockup resolved through the brand registry (contexts web.header and
// web.footer, see lib/logo.ts), inlined so it takes the theme's ink colour.
interface Props { href?: string; size?: 'header' | 'footer' }
const { href = '/', size = 'header' } = Astro.props;
const svg = lockupSvg(size);
---
<a class={`wordmark ${size}`} href={href} aria-label={`${brand.name}, home`}>
  <Fragment set:html={svg} />
</a>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  /* Heights from docs/brand/BRAND_SYSTEM.md: master lockup from 27px, small cut below. */
  .wordmark :global(.lockup) { height: 28px; width: auto; }
  .footer :global(.lockup) { height: 22px; }
</style>
