# Local `expo start` (development mode) only. Not a secret. See src/lib/build-env.ts.
# EAS builds set EXPO_PUBLIC_APP_ENV per profile in eas.json; production is only ever
# set there, explicitly. An unset value means development (POPS-02).
# Never commit secrets to any .env file: secret values live in EAS environment
# variables (app.config.ts header lists them).
EXPO_PUBLIC_APP_ENV=development
# Server features (sign-in, sync, co-parent sharing): off for v1.0 (src/lib/capabilities.ts). Set to `on` only to work on v1.1.
EXPO_PUBLIC_SERVER_FEATURES=off
