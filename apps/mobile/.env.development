# Local `expo start` (development mode) only. EAS builds set EXPO_PUBLIC_APP_ENV per profile in eas.json.
# Not a secret. See src/lib/build-env.ts.
EXPO_PUBLIC_APP_ENV=development
# Server features (sign-in, sync, co-parent sharing): off for v1.0 (src/lib/capabilities.ts). Set to `on` only to work on v1.1.
EXPO_PUBLIC_SERVER_FEATURES=off
