{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earlyletters.com/export-format/v1.schema.json",
  "title": "Early Letters export, format 1",
  "description": "Schema for data/entries.json, data/children.json, data/account.json, data/other-versions.json (when present) and manifest.json in an export.",
  "$defs": {
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "duration_ms",
        "codec",
        "media_type",
        "integrity",
        "recorded_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^audio/[^/]+\\.(m4a|aac)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "codec": {
          "const": "aac-lc"
        },
        "media_type": {
          "enum": [
            "audio/mp4",
            "audio/aac"
          ]
        },
        "integrity": {
          "enum": [
            "ok",
            "mismatch",
            "unchecked"
          ]
        },
        "recorded_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "media_type": {
            "const": "audio/aac"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\.aac$"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\.m4a$"
          }
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "end",
        "original",
        "replacement",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "original": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "child_id",
        "author",
        "kind",
        "occurred_on",
        "captured_at",
        "capture_mode",
        "edit_level",
        "language",
        "words",
        "final_text",
        "in_book",
        "text_file",
        "photo",
        "audio",
        "audio_missing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "child_id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signs_as",
            "is_exporter"
          ],
          "properties": {
            "signs_as": {
              "type": "string"
            },
            "is_exporter": {
              "type": "boolean"
            }
          }
        },
        "kind": {
          "enum": [
            "letter",
            "note",
            "not_much"
          ]
        },
        "occurred_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "captured_at": {
          "type": "string",
          "minLength": 10
        },
        "capture_mode": {
          "enum": [
            "spoken",
            "typed",
            "mixed"
          ]
        },
        "edit_level": {
          "enum": [
            "clean",
            "verbatim"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "words": {
          "enum": [
            "ready",
            "waiting_for_words"
          ]
        },
        "final_text": {
          "type": "string"
        },
        "in_book": {
          "type": "boolean"
        },
        "text_file": {
          "type": "string",
          "pattern": "^letters/"
        },
        "photo": {
          "type": "null"
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/audio"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio_missing": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "not_on_this_device",
                    "offline",
                    "vault_mode"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_transcript": {
          "type": "string"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "machine_edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edit"
          }
        },
        "engine_version": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "sounds_like_me": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stt_meta": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine"
              ],
              "properties": {
                "engine": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "alignment": {
          "type": "null"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "author": {
            "type": "object",
            "properties": {
              "is_exporter": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "raw_transcript",
          "raw_sha256",
          "machine_edits",
          "engine_version",
          "prompt_key"
        ]
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "raw_transcript"
              ]
            },
            {
              "type": "object",
              "required": [
                "machine_edits"
              ]
            },
            {
              "type": "object",
              "required": [
                "raw_sha256"
              ]
            }
          ]
        }
      }
    },
    "entriesFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "format",
        "generated_at",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "format": {
          "const": "early-letters-export"
        },
        "generated_at": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "childrenFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "format",
        "children"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "format": {
          "const": "early-letters-export"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "birthday",
              "due_date",
              "signs_as",
              "signatures",
              "hidden",
              "book_file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "birthday": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "due_date": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "signs_as": {
                "type": "string"
              },
              "signatures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hidden": {
                "type": "boolean"
              },
              "book_file": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^book/.+\\.pdf$"
              }
            }
          }
        }
      }
    },
    "otherVersionsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "format",
        "versions"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "format": {
          "const": "early-letters-export"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_id",
              "reason",
              "final_text",
              "edit_level",
              "machine_edits",
              "kept_at"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "conflict_copy"
                ]
              },
              "final_text": {
                "type": "string"
              },
              "edit_level": {
                "type": "string"
              },
              "machine_edits": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/edit"
                }
              },
              "kept_at": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "accountFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "format",
        "signed_in",
        "plan",
        "exported_from",
        "memberships"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "format": {
          "const": "early-letters-export"
        },
        "signed_in": {
          "type": "boolean"
        },
        "plan": {
          "enum": [
            "free",
            "plus"
          ]
        },
        "exported_from": {
          "const": "phone"
        },
        "memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "child_id",
              "role",
              "signs_as"
            ],
            "properties": {
              "child_id": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "parent",
                  "contributor"
                ]
              },
              "signs_as": {
                "type": "string"
              }
            }
          }
        },
        "consent_on_this_phone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "age_confirmed",
            "usage_sharing"
          ],
          "properties": {
            "age_confirmed": {
              "type": "boolean"
            },
            "usage_sharing": {
              "enum": [
                "granted",
                "denied",
                "not_answered"
              ]
            }
          }
        },
        "consent_history": {
          "$ref": "#/$defs/consentHistory"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "dictionary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dictionaryTerm"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "read_at",
        "display_name",
        "signs_as",
        "created_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "included",
            "not_signed_in",
            "different_account",
            "unavailable"
          ]
        },
        "read_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "signs_as": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "included"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "read_at": {
            "type": "string"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "read_at": {
            "type": "null"
          },
          "display_name": {
            "type": "null"
          },
          "signs_as": {
            "type": "null"
          },
          "created_at": {
            "type": "null"
          }
        }
      }
    },
    "consentHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "read_at",
        "current",
        "acts"
      ],
      "properties": {
        "status": {
          "enum": [
            "included",
            "not_signed_in",
            "different_account",
            "unavailable"
          ]
        },
        "read_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document",
              "version",
              "action",
              "at"
            ],
            "properties": {
              "document": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "accept",
                  "decline",
                  "withdraw",
                  "acknowledge"
                ]
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "document",
              "version",
              "action",
              "method",
              "surface",
              "at",
              "client_recorded_at",
              "app_version",
              "platform",
              "locale",
              "rendered_sha256",
              "context"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "document": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "accept",
                  "decline",
                  "withdraw",
                  "acknowledge"
                ]
              },
              "method": {
                "type": "string"
              },
              "surface": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "client_recorded_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "app_version": {
                "type": "string"
              },
              "platform": {
                "enum": [
                  "ios",
                  "android",
                  "web"
                ]
              },
              "locale": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rendered_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "context": {
                "type": "object"
              }
            }
          }
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "included"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "read_at": {
            "type": "string"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "read_at": {
            "type": "null"
          },
          "current": {
            "type": "array",
            "maxItems": 0
          },
          "acts": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "dictionaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_id",
        "term",
        "kind",
        "heard_as",
        "source"
      ],
      "properties": {
        "child_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "term": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "child",
            "nickname",
            "family",
            "word",
            "place",
            "self"
          ]
        },
        "heard_as": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "enum": [
            "phone",
            "server"
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "generated_at",
        "app_version",
        "engine_version",
        "scope",
        "counts",
        "files"
      ],
      "properties": {
        "format": {
          "const": "early-letters-export"
        },
        "format_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "generated_at": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "engine_version": {
          "type": "integer"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exporter_role",
            "children",
            "include_recently_deleted"
          ],
          "properties": {
            "exporter_role": {
              "enum": [
                "parent",
                "contributor"
              ]
            },
            "children": {
              "type": "integer",
              "minimum": 0
            },
            "include_recently_deleted": {
              "type": "boolean"
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entries",
            "audio",
            "audio_missing",
            "audio_mismatch",
            "photos",
            "books"
          ],
          "properties": {
            "entries": {
              "type": "integer",
              "minimum": 0
            },
            "audio": {
              "type": "integer",
              "minimum": 0
            },
            "audio_missing": {
              "type": "integer",
              "minimum": 0
            },
            "audio_mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "photos": {
              "type": "integer",
              "minimum": 0
            },
            "books": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256",
              "media_type"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "media_type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/entriesFile"
    },
    {
      "$ref": "#/$defs/childrenFile"
    },
    {
      "$ref": "#/$defs/accountFile"
    },
    {
      "$ref": "#/$defs/manifest"
    }
  ]
}
