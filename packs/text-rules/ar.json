  "normalization": {
    "review": {
      "status": "cited",
      "date": "2026-10-03",
      "sources": [
        "Unicode Standard Annex #15, Unicode Normalization Forms, https://unicode.org/reports/tr15/",
        "Unicode Standard, ch. 9.2 Arabic: U+0640 ARABIC TATWEEL is an elongation (kashida) used for justification, not part of a word’s spelling",
        "Harakat (U+064B..U+0652, U+0670) are kept exactly as recognised, never added or removed; ignored only when a word is compared with the tables",
        "Dialect words are never normalised to Modern Standard Arabic: alef and ya folds apply to table look-ups only, never to the text"
      ]
    },
    "form": "NFC",
    "dropFromFinal": [
      "ـ"
    ],
    "ignoreForMatching": [
      "ً",
      "ٌ",
      "ٍ",
      "َ",
      "ُ",
      "ِ",
      "ّ",
      "ْ",
      "ٰ",
      "ـ"
    ],
    "foldForMatching": {
      "أ": "ا",
      "إ": "ا",
      "آ": "ا",
      "ٱ": "ا",
      "ى": "ي"
    },
    "house": {
      "dashes": "replace",
      "dashTo": "، ",
      "quotes": "straight",
      "ellipsis": "dots",
      "spaces": "plain"
    }
  },
  "punctuation": {
    "review": {
      "status": "cited",
      "date": "2026-10-03",
      "sources": [
        "Unicode Standard, ch. 9.2 Arabic: U+060C ARABIC COMMA, U+061B ARABIC SEMICOLON, U+061F ARABIC QUESTION MARK",
        "Arabic full stop is U+002E"
      ]
    },
    "sentenceEnd": [
