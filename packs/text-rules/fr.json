  "normalization": {
    "review": {
      "status": "cited",
      "date": "2026-10-03",
      "sources": [
        "Unicode Standard Annex #15, Unicode Normalization Forms, https://unicode.org/reports/tr15/",
        "French typography keeps no-break spaces before ; : ! ? and inside « » (see punctuation sources), so they survive the final text"
      ]
    },
    "form": "NFC",
    "dropFromFinal": [],
    "ignoreForMatching": [],
    "foldForMatching": {},
    "house": {
      "dashes": "replace",
      "dashTo": ", ",
      "quotes": "straight",
      "ellipsis": "dots",
      "spaces": "keep"
    }
  },
  "punctuation": {
    "review": {
      "status": "cited",
      "date": "2026-10-03",
      "sources": [
        "Office québécois de la langue française, Vitrine linguistique, \"Espacement avant et après les signes de ponctuation\": no-break space before the colon and inside « »; before ; ! ? a fine space or none, https://vitrinelinguistique.oqlf.gouv.qc.ca/22039/la-typographie/espacement/espacement-avant-et-apres-les-signes-de-ponctuation-et-les-symboles",
        "Imprimerie nationale, Lexique des règles typographiques en usage à l’Imprimerie nationale: espace fine insécable before ; ! ?",
        "Region-safe rule: an existing space before ; ! ? becomes a narrow no-break space; a missing one is never added (Quebec omits it)"
      ]
    },
    "sentenceEnd": [
      ".",
      "!",
      "?"
    ],
    "terminal": ".",
    "openers": [],
    "pairOpeners": false,
    "quotes": [
      "«",
      "»"
    ],
    "commas": [],
    "localForms": {},
    "localFormsSwallowSpace": false,
    "spaceBefore": [
      {
        "mark": ";",
        "space": "narrow",
        "insert": false
      },
      {
        "mark": "!",
        "space": "narrow",
        "insert": false
      },
      {
        "mark": "?",
        "space": "narrow",
        "insert": false
      },
      {
        "mark": ":",
        "space": "nbsp",
        "insert": true
      }
    ],
    "spaceInsideGuillemets": true
  },
  "fillers": {
    "review": {
      "status": "draft",
      "date": "2026-10-03",
      "sources": [
        "Kosmala & Crible, \"The dual status of filled pauses\", Language and Speech (2021): \"euh\" is the main French filled pause; \"ben\" and \"bah\" are discourse markers and are kept, https://halshs.archives-ouvertes.fr/halshs-03225622"
      ]
    },
