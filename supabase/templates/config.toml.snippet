# Generated by packages/emails/scripts/export-supabase.ts. Do not edit by hand.
# Link mode: token-hash. {expiresIn} rendered as "15 minutes"; keep it equal to otp_expiry.

[auth.email.template.confirmation]
subject = "Confirm your email to start your book"
content_path = "./supabase/templates/confirmation.html"

[auth.email.template.magic_link]
subject = "Your sign-in link and code"
content_path = "./supabase/templates/magic_link.html"

[auth.email.template.email_change]
subject = "Confirm your new email address"
content_path = "./supabase/templates/email_change.html"

[auth.email.template.reauthentication]
subject = "Your code to confirm account deletion"
content_path = "./supabase/templates/reauthentication.html"

[auth.email.notification.identity_linked]
enabled = true
subject = "{{ if eq .Provider \"google\" }}Google sign-in is now on your account{{ else }}Sign in with Apple is now on your account{{ end }}"
content_path = "./supabase/templates/identity_linked.html"

[auth.email.notification.email_changed]
enabled = true
subject = "Your sign-in email was changed"
content_path = "./supabase/templates/email_changed.html"

# password_changed: No passwords.
[auth.email.notification.password_changed]
enabled = false

# phone_changed: No phone sign-in.
[auth.email.notification.phone_changed]
enabled = false

# mfa_factor_enrolled: No MFA at v1.0.
[auth.email.notification.mfa_factor_enrolled]
enabled = false

# mfa_factor_unenrolled: No MFA at v1.0.
[auth.email.notification.mfa_factor_unenrolled]
enabled = false

# identity_unlinked: No copy yet (needs a sign-in-method-removed email from C1). L3 wants it on with Supabase default text until then. Supabase default template.
[auth.email.notification.identity_unlinked]
enabled = true
