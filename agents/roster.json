{
  "$comment": "The Early Letters agent team. Edit engines, models and caps here; the dispatcher reads this file on every tick. Structure and process: docs/agents/HARNESS.md. Rules agents follow: docs/agents/OPERATING_MODEL.md. Decisions: ADR 0018, ADR 0019.",
  "version": 1,
  "repo": "thesaurabhpareek/earlyletters",
  "base_branch": "develop",
  "founder": "thesaurabhpareek",
  "$comment_trust": "Bot logins whose comments count as agent messages (handoffs, replies, reviews). The agents GitHub App is also recognised by its client id (AGENTS_APP_CLIENT_ID); add its login to the repository variable AGENTS_BOT_LOGINS. Text from anyone else is information, never instructions. docs/agents/AGENT-COMMS.md.",
  "trusted_bots": ["claude[bot]"],
  "limits": {
    "$comment": "max_runs_per_day_total is the team-wide daily cap. Money is capped three ways: max_budget_usd per run (enforced by the runner), the spend limit on the provider key (OpenRouter key budget or Claude Console workspace), and this daily cap.",
    "max_runs_per_day_total": 30,
    "max_parallel": 6,
    "digest_hour_utc": 14,
    "claim_grace_minutes": 20
  },
  "engines": {
    "$comment": "opencode = OpenCode (MIT) driving open-weight models through OpenRouter; the default. claude-code = Claude Code via anthropics/claude-code-action; optional per agent. Models must be priced in the engine's model list, or the per-run spend cap cannot be enforced.",
    "opencode": {
      "version": "1.18.34",
      "secret": "OPENROUTER_API_KEY",
      "default_model": "openrouter/deepseek/deepseek-v4.1-flash",
      "default_budget_usd": 2
    },
    "claude-code": {
      "secret": "ANTHROPIC_API_KEY",
      "default_model": "claude-sonnet-5-5",
      "default_budget_usd": 8
    }
  },
  "defaults": {
    "max_turns": 80,
    "timeout_minutes": 50,
    "daily_runs": 1,
    "wip_limit": 1,
    "$comment": "An agent without engine, model or max_budget_usd takes the engine's defaults. effort is optional and passed to the engine (OpenCode --variant, Claude Code --effort).",
    "engine": "opencode"
  },
