+-- PENDING: not yet applied. Performance only: the book read path asks "is this letter in the book?"
+-- before it asks "is this person a member?", so the planner can use the in_book partial index.
+-- No change in who can read what: the author reads their own letters, and members read book letters.
+begin;
+drop policy if exists entries_select on public.entries;
+create policy entries_select on public.entries for select to authenticated using (
+  author_id = (select auth.uid())
+  or (in_book and deleted_at is null)
+);
+commit;
